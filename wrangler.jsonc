{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "circularity-minter",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": {
    // 1 AM UTC on the first of every month. 1 AM is used instead of midnight
    // to give humans an hour to burn/mint for on-chain provenance if desired.
    // If they do, this run sees nothing is due and sends no transactions.
    "crons": ["0 1 1 * *"]
  },
  // Set each with `npx wrangler secret put <NAME>` (see README). Deploys fail
  // until all of them are set.
  //   PRIVATE_KEY - 0x-prefixed private key of the wallet that pays gas
  //   RPC_URL     - Ethereum mainnet JSON-RPC endpoint
  //   RUN_TOKEN   - bearer token for the manual POST /run endpoint
  "secrets": {
    "required": ["PRIVATE_KEY", "RPC_URL", "RUN_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
