{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // .cloudflare/types is generated by `cf workers types` (and by cf dev/build)
  "include": ["src", "cloudflare.config.ts", "vite.config.ts", ".cloudflare/types"]
}
